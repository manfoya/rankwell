# Copier ce fichier vers .env puis adapter les valeurs si besoin.

# --- PostgreSQL / Docker ---
POSTGRES_USER=rankwell
POSTGRES_PASSWORD=rankwell
POSTGRES_DB=rankwell

# Phase 3 : base principale
DATABASE_URL=postgresql://rankwell:rankwell@localhost:5432/rankwell

# Phase 4 : bases fragmentées (séparées par des virgules)
SHARD_DATABASE_URLS=postgresql://rankwell:rankwell@localhost:5433/rankwell,postgresql://rankwell:rankwell@localhost:5434/rankwell

# --- Crawler ---
USER_AGENT=RankWellBot/0.1 (+https://example.org/bot)
CRAWL_DELAY_SECONDS=1.0

# --- PageRank ---
DAMPING=0.85
TOLERANCE=1e-6
MAX_ITERATIONS=200

# --- Recherche ---
TOP_K=10
WEIGHT_BM25=0.7

# --- Chemins locaux ---
DATA_DIR=data
